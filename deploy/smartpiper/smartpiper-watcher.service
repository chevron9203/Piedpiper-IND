[Unit]
Description=smartpiper announcements watcher (market hours, alerts on holdings)
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/smartpiper
ExecStart=/home/ubuntu/smartpiper/.venv/bin/python -u -m smart.watcher
StandardOutput=append:/home/ubuntu/smartpiper/logs/watcher.log
StandardError=append:/home/ubuntu/smartpiper/logs/watcher.log
Restart=always
RestartSec=60
MemoryMax=500M
CPUWeight=20
Nice=10

[Install]
WantedBy=multi-user.target
